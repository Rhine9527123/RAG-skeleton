# ============================================================
# RAG + Hermes 配置文件
# ============================================================
# 首次使用：复制本文件为 .env（已自动完成），填写 API Key 即可
# ============================================================

# ---- LLM 配置（必填） ----
# Kimi API Key，获取地址：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=在这里填写你的API_Key

# 以下一般不用改
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- RAG 配置（一般不用改） ----
RERANKER_MODEL_PATH=/models/bge-reranker-v2-m3

# ---- Ollama 离线模式 ----
# 设为 true 时，LLM 切换为本地 Ollama（断网可用），同时跳过 Reranker 省内存
# 适合 8GB 内存的小主机，需要先安装 Ollama 并拉取模型
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Hermes 配置 ----
# Hermes 容器内通过 Docker 内网访问 RAG 服务（一般不用改）
# 如果手动运行 Hermes（非 Docker），改为 http://localhost:8000
RAG_API_URL=http://rag-service:8000

# ---- MCP Server 配置（TRAE IDE 集成） ----
# 项目支持 MCP（模型上下文协议），可在 TRAE IDE 中直接调用
# 详细说明见 TRAE_INTEGRATION.md

# 领域选择：finance / medical / legal / 空（通用）
RAG_DOMAIN=finance

# MCP Server 名称（在 TRAE IDE 中显示的名称）
RAG_MCP_SERVER_NAME=rag-finance

# MCP 智能体指令（告诉 AI 什么时候调用知识库）
RAG_MCP_INSTRUCTIONS=你连接了用户的专属知识库，里面可能包含各种业务文档：税务政策、会计数据、经营分析等。内容类型不固定，取决于用户上传了什么。判断逻辑：涉及「用户自己的数据/文档/业务」→ 调用 rag_chat；纯闲聊/通用常识 → 不调用；拿不准 → 宁可调用，查了再说。
