# ============================================================
# RAG + Hermes 配置文件
# ============================================================
# 首次使用：复制本文件为 .env（已自动完成），填写 API Key 即可
# ============================================================

# ---- LLM 配置（必填） ----
# Kimi API Key，获取地址：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=在这里填写你的API_Key

# 以下一般不用改
KIMI_API_BASE=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# ---- RAG 配置（一般不用改） ----
RERANKER_MODEL_PATH=/models/bge-reranker-v2-m3

# ---- Ollama 离线模式 ----
# 设为 true 时，LLM 切换为本地 Ollama（断网可用），同时跳过 Reranker 省内存
# 适合 8GB 内存的小主机，需要先安装 Ollama 并拉取模型
USE_OLLAMA=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Hermes 配置 ----
# Hermes 容器内通过 Docker 内网访问 RAG 服务（一般不用改）
# 如果手动运行 Hermes（非 Docker），改为 http://localhost:8000
RAG_API_URL=http://rag-service:8000
